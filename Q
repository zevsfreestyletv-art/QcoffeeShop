</div>
</div></div></div>

<script>
const KEY='qcoffee_menu_v1';
let data=JSON.parse(localStorage.getItem(KEY)||'null')||{
 categories:['Кофе','Чай','Лимонады','Завтраки','Основные блюда','Десерты'],
 items:[]
};
let active=data.categories[0]||'Все', editingId=null, photoData='';

function persist(){localStorage.setItem(KEY,JSON.stringify(data));render();}
function render(){
 if(!data.categories.includes(active)) active=data.categories[0]||'Все';
 tabs.innerHTML=data.categories.map(c=>`<button class="tab ${c===active?'active':''}" onclick="setCat(${JSON.stringify(c)})">${esc(c)}</button>`).join('');
 let items=data.items.filter(x=>x.category===active);
 grid.innerHTML=items.length?items.map(card).join(''):`<div class="empty">В этой категории пока нет блюд.<br>Добавь первое через «Редактор меню».</div>`;
 renderAdmin();
}
function setCat(c){active=c;render()}
function card(x){
 return `<article class="card">${x.photo?`<img class="photo" src="${x.photo}" alt="">`:`<div class="photo no-photo">Фото скоро</div>`}
 <div class="info"><div class="name">${esc(x.name)}</div>${x.size?`<div class="small">${esc(x.size)}</div>`:''}
 ${x.price!==''?`<div class="price">${Number(x.price).toLocaleString('ru-RU')} ₸</div>`:''}
 ${x.desc?`<div class="desc">${esc(x.desc)}</div>`:''}
 ${x.comp?`<div class="composition"><b>Состав:</b> ${esc(x.comp)}</div>`:''}</div></article>`;
}
function renderAdmin(){
 itemCat.innerHTML=data.categories.map(c=>`<option>${esc(c)}</option>`).join('');
 catList.innerHTML=data.categories.map(c=>`<div class="listItem"><span>${esc(c)}</span><button class="danger" onclick="removeCategory(${JSON.stringify(c)})">Удалить</button></div>`).join('');
 itemList.innerHTML=data.items.length?data.items.map(x=>`<div class="listItem"><span><b>${esc(x.name)}</b><br><span class="small">${esc(x.category)} · ${x.price||''} ₸</span></span><span class="actions"><button class="secondary" onclick="editItem('${x.id}')">Изменить</button><button class="danger" onclick="removeItem('${x.id}')">Удалить</button></span></div>`).join(''):'<div class="small">Пока нет блюд.</div>';
}
function addCategory(){
 const n=catName.value.trim(); if(!n)return;
 if(!data.categories.includes(n))data.categories.push(n);catName.value='';active=n;persist();
}
function removeCategory(c){
 if(data.categories.length<=1)return alert('Оставь хотя бы одну категорию.');
 if(data.items.some(x=>x.category===c))return alert('Сначала перенеси или удали блюда из этой категории.');
 data.categories=data.categories.filter(x=>x!==c);active=data.categories[0];persist();
}
function saveItem(){
 const name=itemName.value.trim();if(!name)return alert('Укажи название блюда.');
 const obj={id:editingId||crypto.randomUUID(),category:itemCat.value,name,price:itemPrice.value,size:itemSize.value.trim(),desc:itemDesc.value.trim(),comp:itemComp.value.trim(),photo:photoData};
 const i=data.items.findIndex(x=>x.id===obj.id);if(i>=0)data.items[i]=obj;else data.items.push(obj);
 active=obj.category;clearForm();persist();
}
function editItem(id){
 const x=data.items.find(y=>y.id===id);if(!x)return;
 editingId=id;itemCat.value=x.category;itemName.value=x.name;itemPrice.value=x.price;itemSize.value=x.size;itemDesc.value=x.desc;itemComp.value=x.comp;photoData=x.photo||'';
 preview.src=photoData;preview.style.display=photoData?'block':'none';
}
function removeItem(id){if(confirm('Удалить блюдо?')){data.items=data.items.filter(x=>x.id!==id);persist()}}
function clearForm(){editingId=null;itemName.value='';itemPrice.value='';itemSize.value='';itemDesc.value='';itemComp.value='';itemPhoto.value='';photoData='';preview.style.display='none'}
function previewPhoto(){const f=itemPhoto.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{photoData=r.result;preview.src=photoData;preview.style.display='block'};r.readAsDataURL(f)}
function openAdmin(){modal.classList.add('open');renderAdmin()}function closeAdmin(){modal.classList.remove('open')}
function exportMenu(){const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='q-coffee-menu.json';a.click()}
function importMenu(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{data=JSON.parse(r.result);active=data.categories[0]||'Все';persist();alert('Меню импортировано.')}catch{alert('Файл меню повреждён.')}};r.readAsText(f)}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
render();
</script>
</body></html>'''

