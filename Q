.tabs{display:flex;gap:9px;overflow:auto;padding:16px 0 18px;scrollbar-width:none}.tabs::-webkit-scrollbar{display:none}
.tab{white-space:nowrap;border:1px solid var(--line);background:transparent;border-radius:999px;padding:10px 15px;color:var(--muted)}
.tab.active{background:var(--accent);color:white;border-color:var(--accent)}
